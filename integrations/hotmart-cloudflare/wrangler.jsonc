{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gtc-hotmart-webhook",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "globaltechcareer.com/api/*",
      "zone_name": "globaltechcareer.com"
    },
    {
      "pattern": "www.globaltechcareer.com/api/*",
      "zone_name": "globaltechcareer.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gtc-sales",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GA4_MEASUREMENT_ID": "G-96MRR9EKX4"
  },
  "secrets": {
    "required": ["HOTMART_HOTTOK", "GA4_API_SECRET"]
  }
}
